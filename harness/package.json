{
  "name": "@snm/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Agent harness for the SouthNorth Solutions analytics agent, built on PI core packages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-models": "tsc -p tsconfig.build.json && NODE_USE_ENV_PROXY=1 node dist/cli/check-models.js",
    "ask": "tsc -p tsconfig.build.json && NODE_USE_ENV_PROXY=1 node dist/cli/ask.js",
    "case": "tsc -p tsconfig.build.json && NODE_USE_ENV_PROXY=1 node dist/cli/case.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
