# Local development: copy to .env (git-ignored) and fill in values. Never commit real values.
# Cloud sessions: set these in the environment settings instead of a file.
# Precedence: real environment variables > .env; empty values are ignored.

# Anthropic (TypeScript harness process only). Project-specific name on purpose: a plain
# ANTHROPIC_API_KEY would also be picked up by Claude Code and SDK defaults.
SNM_ANTHROPIC_API_KEY=
SNM_MODEL_PROVIDER=anthropic
SNM_MODEL_MAIN=
SNM_MODEL_EXPLORER=
# IDs missing from the pinned PI catalog must be listed in harness/config/model-catalog.json.
SNM_MODEL_VERIFIER=
SNM_EFFORT_MAIN=medium
SNM_EFFORT_EXPLORER=low
SNM_EFFORT_VERIFIER=high
# Proposer of the improvement loop (record 009); empty falls back to SNM_MODEL_VERIFIER.
SNM_MODEL_IMPROVER=
SNM_EFFORT_IMPROVER=medium

# Databricks (Python tool server and data tooling only)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
# Agent role service principals (OAuth clients), from `snm-data govern --issue-credentials`.
# The harness passes only the active role's pair to the tool server.
SNM_DATABRICKS_CLIENT_ID_OPS_ANALYST_GLOBAL=
SNM_DATABRICKS_CLIENT_SECRET_OPS_ANALYST_GLOBAL=
SNM_DATABRICKS_CLIENT_ID_SITE_MANAGER_RR=
SNM_DATABRICKS_CLIENT_SECRET_SITE_MANAGER_RR=
SNM_DATABRICKS_CLIENT_ID_SITE_MANAGER_CN=
SNM_DATABRICKS_CLIENT_SECRET_SITE_MANAGER_CN=
SNM_DATABRICKS_CLIENT_ID_TRADE_COMPLIANCE=
SNM_DATABRICKS_CLIENT_SECRET_TRADE_COMPLIANCE=
# MLflow experiment for evaluation batches (default: /Users/<you>/snm-agent-evals)
SNM_MLFLOW_EXPERIMENT=
SNM_CATALOG=snm
